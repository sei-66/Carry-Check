{
  "name": "carry-check",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "ip-address": "^10.7.4"
  },
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "build:verification": "npm run typecheck && vite build --config config/vite.verification.config.ts",
    "preview:verification": "vite preview --config config/vite.verification.config.ts",
    "build:performance": "npm run build && vite build --config config/vite.performance.config.ts",
    "preview:performance": "vite preview --config config/vite.performance.config.ts",
    "lint": "eslint . --config config/eslint.config.js --max-warnings=0",
    "format": "prettier . --ignore-path .gitignore --ignore-path config/.prettierignore --write",
    "format:check": "prettier . --ignore-path .gitignore --ignore-path config/.prettierignore --check",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "endOfLine": "lf"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "three-mesh-bvh": "0.9.16",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
