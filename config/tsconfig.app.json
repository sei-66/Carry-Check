{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": { "@/*": ["../src/*"] },
    "tsBuildInfoFile": "../cache/tsconfig.app.tsbuildinfo"
  },
  "include": ["../src/**/*.ts", "../src/**/*.tsx"],
  "exclude": ["../src/workers"]
}
